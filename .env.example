# ============================================================================
# CollectiPay Environment Variables (Frontend - Safe for Browser Bundle)
# ============================================================================
# NEVER put secret keys (FLWSECK-*, SUPABASE_SERVICE_ROLE_KEY, sbp_*) in VITE_*
# variables. Secret keys belong strictly in Supabase Edge Function Secrets.

# Supabase Public Configuration
VITE_SUPABASE_URL=https://sivvjwffekhfabgxhbcd.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Flutterwave Public Key (client checkout only)
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your_flutterwave_public_key

# Always use Supabase Edge Functions in production
VITE_USE_SUPABASE=true

# ============================================================================
# Local Tooling / CLI Only (store in gitignored .env.local, NOT in browser)
# ============================================================================
# SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
# SUPABASE_PROJECT_REF=sivvjwffekhfabgxhbcd
