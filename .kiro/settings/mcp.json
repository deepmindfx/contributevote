{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref",
        "sivvjwffekhfabgxhbcd"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      },
      "disabled": false,
      "autoApprove": [
        "list_edge_functions",
        "get_edge_function",
        "get_project",
        "list_tables",
        "list_projects",
        "get_logs",
        "search_docs",
        "get_advisors",
        "list_migrations"
      ]
    }
  }
}
